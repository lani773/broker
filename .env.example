# LUMA MQTT Broker v2 – Environment Variables
# Copy to .env: cp .env.example .env

# ─── Security (REQUIRED: change all of these) ─────────────────────────────────
JWT_SECRET=replace-with-32-plus-random-bytes-openssl-rand-hex-32
ADMIN_PASSWORD=replace-with-strong-password
POSTGRES_PASSWORD=replace-with-strong-password
GRAFANA_PASSWORD=admin

# ─── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_TCP_ADDR=:1883
MQTT_TLS_ADDR=:8883
MQTT_WS_ADDR=:8083
MQTT_WS_ENABLED=true
# Comma-separated; use * for permissive Dev. Tight list for browser clients in prod.
MQTT_WS_ALLOWED_ORIGINS=*
MQTT_QUIC_ADDR=:1884
MQTT_QUIC_ENABLED=false
MAX_CONNECTIONS=50000
WRITE_QUEUE_SIZE=512
# MQTT v5 Topic Alias Maximum in CONNACK (0 = disable)
MQTT_TOPIC_ALIAS_MAX=64

# ─── TLS (optional) ───────────────────────────────────────────────────────────
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=./certs/ca.crt
# TLS_CLIENT_AUTH_MODE=require_and_verify
# TLS_REVOKED_SERIALS=abc123,def456

# ─── API ──────────────────────────────────────────────────────────────────────
API_ADDR=:8080
API_ALLOWED_ORIGINS=*
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s

# ─── Storage ──────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_POOL_SIZE=50
POSTGRES_DSN=postgres://mqtt:${POSTGRES_PASSWORD}@localhost:5432/mqtt?sslmode=disable
PG_MAX_CONNS=25

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_DURATION=24h
JWT_ISSUER=luma-broker
BCRYPT_COST=12
RATE_LIMIT=1000
RATE_BURST=2000

# ─── Cluster ──────────────────────────────────────────────────────────────────
CLUSTER_MODE=false
# BROKER_ID=broker-1   # auto-generated UUID if unset
CLUSTER_PARTITIONS=128
CLUSTER_REPLICAS=3
CLUSTER_PARTITION_SYNC_INTERVAL=10s
CLUSTER_BROKER_HEARTBEAT_INTERVAL=5s
CLUSTER_BROKER_STALE_AFTER=30s

# ─── Enterprise SLO Targets ───────────────────────────────────────────────────
SLO_TARGET_MESSAGES_PER_SEC=1000000
SLO_TARGET_P99_MS=50
SLO_TARGET_CONNECTIONS=100000000
SLO_FAILOVER_RTO_SECONDS=60
SLO_FAILOVER_RPO_SECONDS=10
SLO_ERROR_BUDGET_PERCENT=0.1

# ─── Metrics ──────────────────────────────────────────────────────────────────
METRICS_ADDR=:9090
METRICS_ENABLED=true

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info       # debug | info | warn | error
LOG_FORMAT=json      # json | console
